# --- Storage ---
CLIP_STORAGE_DIR=/tmp/clip-storage
CLIP_MAX_UPLOAD_BYTES=2147483648

# --- Inference ---
# Which backend runs the model:
#   local — load on this machine (needs NVIDIA GPU + CUDA)
#   modal — call out to a deployed Modal app (see modal_app.py)
CLIP_BACKEND=modal
# Only used when CLIP_BACKEND=local
CLIP_DEVICE=cuda
# Set to 1 to lazy-load models on first request (default)
# Set to 0 to preload on startup (slower boot, faster first request)
CLIP_LAZY_LOAD=1

# --- HF ---
# Optional: token for gated/private model access
# HF_TOKEN=hf_xxx
# Cache models in a custom dir (default ~/.cache/huggingface)
# HF_HOME=/data/huggingface

# --- Milestone 1+ ---
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://clip:clip@localhost/clip
# S3_BUCKET=clip-videos
# S3_ENDPOINT=https://...
